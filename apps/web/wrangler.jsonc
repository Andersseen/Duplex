{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duplex-web",
  "main": "dist/analog/server/index.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/analog/public",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
}
