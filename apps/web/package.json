{
  "name": "@duplex/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Duplex browser app (Analog.js + Angular).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module vite build",
    "deploy": "node ../../scripts/deploy-web.mjs",
    "preview": "vite preview",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@analogjs/router": "^2.8.0",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@duplex/protocol": "workspace:*",
    "@duplex/webrtc": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/build": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@duplex/config": "workspace:*",
    "front-matter": "^4.0.2",
    "@types/node": "^22.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
