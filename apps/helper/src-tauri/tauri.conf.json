{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duplex Helper",
  "version": "0.0.0",
  "identifier": "app.duplex.helper",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Duplex Helper",
        "width": 440,
        "height": 640,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
