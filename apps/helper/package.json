{
  "name": "@duplex/helper",
  "version": "0.0.0",
  "private": true,
  "description": "Duplex native helper (Tauri 2 + Angular): temporary control-session bridge with native macOS pointer control.",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "test": "ng test --no-watch",
    "tauri": "tauri",
    "test:coverage": "ng test --no-watch --configuration coverage"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@tauri-apps/api": "^2.12.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@duplex/config": "workspace:*",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
