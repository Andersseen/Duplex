{
  "name": "@duplex/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Duplex backend: Cloudflare Worker (Hono) and the CallRoom Durable Object.",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node ../../scripts/deploy-worker.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@duplex/protocol": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@duplex/config": "workspace:*",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "^10.13.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  }
}
