{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@0.0.81"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "volt-ui": {
      "type": "http",
      "url": "https://volt-ui.pages.dev/api/mcp"
    },
    "entwine": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["exec", "entwine-mcp", "--root", "."]
    }
  }
}
