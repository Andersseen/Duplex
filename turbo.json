{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
